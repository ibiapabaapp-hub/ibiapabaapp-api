generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model Lead {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  type         String    @db.VarChar(10)
  company_name String?   @db.VarChar(50)
  phone_number String    @db.VarChar(20)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  @@map("Lead")
}

model CityCategory {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id     String @db.Uuid
  category_id String @db.Uuid

  city     City     @relation(fields: [city_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([city_id, category_id])
  @@index([city_id])
  @@index([category_id])
  @@map("CityCategory")
}

model Category {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id String? @db.Uuid
  name      String  @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  City              CityCategory[]
  companyCategories CompanyCategory[]

  @@index([parent_id])
  @@index([name])
  @@map("Category")
}

model City {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String  @unique
  name        String
  description String?

  cover_img_url String?

  // PostGIS
  location Unsupported("geometry(Point, 4326)")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // N-N
  categories CityCategory[]

  @@index([created_at(sort: Desc)])
  @@index([location], type: Gist)
  @@map("City")
}

enum UserRole {
  user
  superuser
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(100)
  // cpf                String               @unique @db.VarChar(20)
  birth_date   DateTime  @db.Date
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  phone_number String    @unique @db.VarChar(200)
  password     String    @db.VarChar(255)
  role         UserRole  @default(user)
  active       Boolean   @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  Company UserCompany[]

  @@map("User")
}

model CompanyCategory {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id  String @db.Uuid
  category_id String @db.Uuid

  company  Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([company_id, category_id])
  @@index([company_id])
  @@index([category_id])
  @@map("CompanyCategory")
}

model Company {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String  @unique @db.VarChar(100)
  name String  @db.VarChar(150)
  cnpj String? @db.VarChar(20)

  description   String?
  cover_img_url String?

  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  User       UserCompany[]
  categories CompanyCategory[]

  @@map("Company")
}

enum CompanyRole {
  owner
  admin
  editor
  viewer
}

model UserCompany {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String      @db.Uuid
  company_id String      @db.Uuid
  role       CompanyRole
  created_at DateTime    @default(now()) @db.Timestamp(6)
  updated_at DateTime    @updatedAt @db.Timestamp(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id], map: "uniq_UserCompany")
  @@index([user_id], map: "idx_UserCompany_user")
  @@index([company_id], map: "idx_UserCompany_company")
  @@map("UserCompany")
}

model Media {
  id String @id @default(uuid()) @db.Uuid

  entity_type EntityType
  entity_id   String     @db.Uuid

  media_type MediaType

  url           String
  thumbnail_url String?

  alt_text String?
  credits  String?
  license  String?

  is_cover Boolean @default(false)
  position Int     @default(0)

  metadata Json?

  created_at DateTime @default(now())

  @@index([entity_type, entity_id])
}

enum EntityType {
  city
  event
  company
}

enum MediaType {
  image
  video
}
